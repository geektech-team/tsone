{
  "name": "@geektech/backone-cli",
  "version": "0.1.0",
  "description": "CLI scaffolding tool for BackOne server applications",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "backone": "bin/backone.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:types": "bunx tsc --project tsconfig.build.json",
    "lint": "eslint . --ext .ts",
    "test": "bun test"
  },
  "dependencies": {},
  "devDependencies": {},
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://geektech-team.github.io/tsone/backone/",
  "bugs": {
    "url": "https://github.com/geektech-team/tsone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geektech-team/tsone.git",
    "directory": "packages/backone-cli"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT"
}
