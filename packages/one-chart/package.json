{
  "name": "@geektech/one-chart",
  "version": "0.3.0",
  "description": "One Chart 是基于 TSone 的轻量级纯 TypeScript SVG 图表库",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsone build --library",
    "test": "bun test",
    "docs": "tsone dev",
    "docs:build": "tsone build"
  },
  "peerDependencies": {
    "@geektech/tsone": ">=0.5.0 <0.6.0"
  },
  "devDependencies": {
    "@geektech/tsone": "workspace:*",
    "@geektech/tsone-cli": "workspace:*"
  },
  "files": [
    "dist",
    "README.md",
    "README-zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://geektech-team.github.io/tsone/one-chart/",
  "bugs": {
    "url": "https://github.com/geektech-team/tsone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geektech-team/tsone.git",
    "directory": "packages/one-chart"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  }
}
