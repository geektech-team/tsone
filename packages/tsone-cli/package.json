{
  "name": "@geektech/tsone-cli",
  "version": "0.3.0",
  "description": "Bun-native development and build CLI for TSone applications",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "tsone": "bin/tsone.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:types": "bunx tsc --project tsconfig.build.json",
    "lint": "eslint . --ext .ts",
    "test": "bun test"
  },
  "dependencies": {
    "@geektech/tsone": "workspace:*"
  },
  "devDependencies": {},
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geektech-team/tsone.git",
    "directory": "packages/tsone-cli"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
