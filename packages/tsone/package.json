{
  "name": "@geektech/tsone",
  "version": "0.0.2",
  "description": "TSone 是轻量级纯 TypeScript 前端框架，提供响应式系统、类组件、策略化渲染和路由功能",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./router": {
      "import": "./dist/router/index.js",
      "types": "./dist/router/index.d.ts"
    },
    "./style": {
      "import": "./dist/style/index.js",
      "types": "./dist/style/index.d.ts"
    }
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "docs": "bun scripts/docs.ts",
    "build": "bun scripts/build.ts",
    "build:types": "bunx tsc --project tsconfig.build.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write . --ignore-path .gitignore",
    "test": "bun test",
    "docs:build": "bun scripts/docs.ts --build",
    "preview": "bun scripts/docs.ts"
  },
  "keywords": [
    "typescript",
    "frontend",
    "framework",
    "reactive",
    "component",
    "router"
  ],
  "author": "Jimmie Max(Qianyu)",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "README-zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
